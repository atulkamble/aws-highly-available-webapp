#!/bin/bash
set -euxo pipefail

dnf install -y python3 python3-pip
mkdir -p /opt/capstone
cat > /opt/capstone/requirements.txt <<'REQ'
${app_requirements}
REQ
cat > /opt/capstone/server.py <<'PY'
${app_source}
PY
python3 -m venv /opt/capstone/.venv
/opt/capstone/.venv/bin/pip install --disable-pip-version-check --no-cache-dir -r /opt/capstone/requirements.txt

cat > /etc/systemd/system/capstone.service <<'SERVICE'
[Unit]
Description=AWS highly available web application
After=network-online.target
Wants=network-online.target

[Service]
Environment="AWS_REGION=${aws_region}"
Environment="COUNTER_FUNCTION=${counter_function}"
ExecStart=/opt/capstone/.venv/bin/python /opt/capstone/server.py
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload
systemctl enable --now capstone
